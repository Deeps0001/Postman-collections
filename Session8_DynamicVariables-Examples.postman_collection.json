{
  "info": {
    "_postman_id": "9417fb5d-1df5-464a-b791-d64930b3fd84",
    "name": "Session8_DynamicVariables-Examples",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
