    {
      "name": "GetRequest3(Test validation by scripts)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Response contains Michael\", function () {",
              "    pm.expect(pm.response.text()).to.include(\"Michael\");",
              "});",
              "const jsonRes = pm.response.json();",
              "pm.test(\"check for id lindsay\",function(){",
              "    pm.expect(jsonRes.data[1].id).to.eql(8);",
              "});",
              "pm.test(\"check for Michael last_name as Lawson\",function(){",
              "    pm.expect(jsonRes.data[0].last_name).to.eql(\"Lawson\");",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
